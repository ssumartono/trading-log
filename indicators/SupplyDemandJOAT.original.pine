// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © officialjackofalltrades
//@version=6

indicator("Supply & Demand Order Blocks [JOAT]", "S&D Order Blocks [JOAT]", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ─────────────────────────────────────────────────────────────────────────
//  PALETTE  (CYBERPUNK — near-black, neon cyan / magenta / purple)
// ─────────────────────────────────────────────────────────────────────────
BG      = #05070E
CYAN    = #00E5FF
CYAN_HI = #7CF6FF
MAG     = #FF2E9A
MAG_HI  = #FF84C4
PURPLE  = #A64BFF
LIME    = #7CFF5A
AMBER   = #FFC24B
INKHI   = #EAF2FF
MUTE    = #5A6B8C
FRAME   = #16233D

// ─────────────────────────────────────────────────────────────────────────
//  INPUTS
// ─────────────────────────────────────────────────────────────────────────
gD      = "Order Block Detection"
dispBars= input.int(2, "Displacement window (bars)", minval = 1, maxval = 3, group = gD, tooltip = "How many bars the impulsive move is measured over (1–3). The order block is the last opposing candle before this leg.")
atrMult = input.float(1.5, "Displacement size (ATR ×)", minval = 0.3, step = 0.1, group = gD, tooltip = "The leg must travel more than this multiple of ATR to qualify as institutional displacement.")
reqFVG  = input.bool(false, "Require fair-value gap", group = gD, tooltip = "Only accept a block when the displacement leaves a 3-bar imbalance (FVG).")
atrLen  = input.int(14, "ATR length", minval = 1, group = gD)

gB      = "Block Management"
maxBlocks= input.int(12, "Max live blocks", minval = 2, maxval = 60, group = gB)
extRight = input.int(30, "Zone extension (bars)", minval = 5, group = gB)
minAge   = input.int(2, "Min block age to trade (bars)", minval = 0, group = gB, tooltip = "Ignore taps on a block younger than this so the freshly-formed origin bar cannot self-trigger.")

gT      = "Trend Filter"
useTrend= input.bool(true, "Filter signals by EMA trend", group = gT, tooltip = "Buy demand only above the EMA, sell supply only below it.")
emaLen  = input.int(50, "Trend EMA length", minval = 2, group = gT)
showEMA = input.bool(true, "Plot trend EMA", group = gT)
colorBars= input.bool(true, "Colour candles by trend (cyan up / magenta down)", group = gT)

gR      = "Trade / Risk"
slBuf   = input.float(0.25, "SL buffer beyond block (ATR ×)", minval = 0.0, step = 0.05, group = gR)
tp1R    = input.float(1.0, "TP1 (R)", step = 0.5, group = gR)
tp2R    = input.float(2.0, "TP2 (R)", step = 0.5, group = gR)
tp3R    = input.float(3.0, "TP3 (R)", step = 0.5, group = gR)
showBox = input.bool(true, "Show TP/SL boxes", group = gR)
tradeExt= input.int(25, "TP/SL box width (bars)", minval = 5, group = gR)

gP      = "Dashboard"
showHUD = input.bool(true, "Show dashboard", group = gP)
hudPos  = input.string("Top Right", "Position", options = ["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right"], group = gP)
hudBg   = input.color(#05070E, "Background", group = gP)

// ─────────────────────────────────────────────────────────────────────────
//  HELPERS
// ─────────────────────────────────────────────────────────────────────────
f_pos(string s) =>
    switch s
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.middle_right

// nearest opposing candle offset within the search window (−1 if none)
f_lastDown(int startOff) =>
    idx = -1
    for j = startOff to startOff + 3
        if idx == -1 and close[j] < open[j]
            idx := j
    idx

f_lastUp(int startOff) =>
    idx = -1
    for j = startOff to startOff + 3
        if idx == -1 and close[j] > open[j]
            idx := j
    idx

f_price(float p) =>
    str.tostring(p, format.mintick)

// horizontal BLOCK-depth bar (█ filled, ▒ fade edge, ░ empty) — orderflow identity
f_depth(int n) =>
    seg = math.min(8, n)
    s = ""
    for i = 1 to 8
        s := s + (i <= seg ? "█" : i == seg + 1 ? "▒" : "░")
    s

// span a level line across the active trade window (setters on parameter — v6 safe)
f_setLine(line ln, int x1, int x2, float p) =>
    line.set_xy1(ln, x1, p)
    line.set_xy2(ln, x2, p)

atr = ta.atr(atrLen)
atrSafe = na(atr) or atr <= 0 ? syminfo.mintick : atr   // guards flat-price / warmup division
ema = ta.ema(close, emaLen)
upTrend = close > ema
dnTrend = close < ema

// ─────────────────────────────────────────────────────────────────────────
//  DISPLACEMENT  (confirmed leg over the last `dispBars` bars)
// ─────────────────────────────────────────────────────────────────────────
legUp   = close - close[dispBars]
legDn   = close[dispBars] - close
strongUp= legUp > atrMult * atr
strongDn= legDn > atrMult * atr

// 3-bar fair-value gap left by the displacement
fvgUp = low > high[2]
fvgDn = high < low[2]

// only spawn on the bar the displacement first appears (non-repainting, no spam)
newBullDisp = strongUp and not strongUp[1] and (not reqFVG or fvgUp)
newBearDisp = strongDn and not strongDn[1] and (not reqFVG or fvgDn)

// ─────────────────────────────────────────────────────────────────────────
//  ORDER-BLOCK STORE  (parallel arrays)
// ─────────────────────────────────────────────────────────────────────────
var array<box>   obBox  = array.new<box>()
var array<float> obTop  = array.new<float>()
var array<float> obBot  = array.new<float>()
var array<int>   obDir  = array.new<int>()   // +1 demand, −1 supply
var array<int>   obL    = array.new<int>()   // origin bar_index (left edge)
var array<float> obStr  = array.new<float>() // displacement strength 0..1
var array<bool>  obMit  = array.new<bool>()  // mitigated flag

// ── create demand block: last down candle before bullish displacement ──
if newBullDisp
    off = f_lastDown(dispBars)
    if off >= 0
        t  = high[off]
        bt = low[off]
        strength = math.min(1.0, legUp / (atrSafe * 3.0))
        transp   = math.round(86 - strength * 24)
        b = box.new(bar_index - off, t, bar_index + extRight, bt, border_color = color.new(CYAN, math.max(0, transp - 30)), bgcolor = color.new(CYAN, transp), border_width = 1, text = "Demand", text_color = color.new(CYAN_HI, 10), text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_top)
        array.push(obBox, b)
        array.push(obTop, t)
        array.push(obBot, bt)
        array.push(obDir, 1)
        array.push(obL, bar_index - off)
        array.push(obStr, strength)
        array.push(obMit, false)

// ── create supply block: last up candle before bearish displacement ──
if newBearDisp
    off = f_lastUp(dispBars)
    if off >= 0
        t  = high[off]
        bt = low[off]
        strength = math.min(1.0, legDn / (atrSafe * 3.0))
        transp   = math.round(86 - strength * 24)
        b = box.new(bar_index - off, t, bar_index + extRight, bt, border_color = color.new(MAG, math.max(0, transp - 30)), bgcolor = color.new(MAG, transp), border_width = 1, text = "Supply", text_color = color.new(MAG_HI, 10), text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_bottom)
        array.push(obBox, b)
        array.push(obTop, t)
        array.push(obBot, bt)
        array.push(obDir, -1)
        array.push(obL, bar_index - off)
        array.push(obStr, strength)
        array.push(obMit, false)

// ── prune mitigated blocks + refresh live zones (fade with age) ──
if array.size(obBox) > 0
    for i = array.size(obBox) - 1 to 0
        b   = array.get(obBox, i)
        d   = array.get(obDir, i)
        t   = array.get(obTop, i)
        bt  = array.get(obBot, i)
        mitigated = d == 1 ? close < bt : close > t
        if mitigated
            box.delete(b)
            array.remove(obBox, i)
            array.remove(obTop, i)
            array.remove(obBot, i)
            array.remove(obDir, i)
            array.remove(obL, i)
            array.remove(obStr, i)
            array.remove(obMit, i)
        else
            age  = bar_index - array.get(obL, i)
            str_ = array.get(obStr, i)
            baseT= 86 - str_ * 24
            ageT = math.min(22.0, age * 0.35)
            tp   = math.min(92.0, baseT + ageT)
            col  = d == 1 ? CYAN : MAG
            box.set_bgcolor(b, color.new(col, math.round(tp)))
            box.set_border_color(b, color.new(col, math.round(math.max(0.0, tp - 30))))
            box.set_right(b, bar_index + extRight)

// ── cap live blocks (drop oldest) ──
while array.size(obBox) > maxBlocks
    box.delete(array.shift(obBox))
    array.shift(obTop)
    array.shift(obBot)
    array.shift(obDir)
    array.shift(obL)
    array.shift(obStr)
    array.shift(obMit)

// ─────────────────────────────────────────────────────────────────────────
//  SIGNAL SCAN  (tap + rejection off a fresh block; trend-filtered)
// ─────────────────────────────────────────────────────────────────────────
bool  buy      = false
bool  sell     = false
float sigTop   = na
float sigBot   = na
float sigStr   = 0.0
int   demandN  = 0
int   supplyN  = 0
float nearDist = na

if array.size(obBox) > 0
    for i = array.size(obBox) - 1 to 0
        d   = array.get(obDir, i)
        t   = array.get(obTop, i)
        bt  = array.get(obBot, i)
        age = bar_index - array.get(obL, i)
        mid = (t + bt) / 2.0
        dist= math.abs(close - mid)
        if na(nearDist) or dist < nearDist
            nearDist := dist
        if d == 1
            demandN += 1
            tapped = low <= t and close > bt and close > open
            if tapped and age >= minAge and (not useTrend or upTrend)
                buy    := true
                sigTop := t
                sigBot := bt
                sigStr := array.get(obStr, i)
        else
            supplyN += 1
            tapped = high >= bt and close < t and close < open
            if tapped and age >= minAge and (not useTrend or dnTrend)
                sell   := true
                sigTop := t
                sigBot := bt
                sigStr := array.get(obStr, i)

buy  := buy and not sell        // one direction per bar
sig   = buy or sell

// ── signal debounce — Buy/Sell can never stack on any timeframe
minGap = input.int(8, "Min bars between signals", minval = 0, group = "Signals", tooltip = "Minimum bar spacing between printed signals so labels never overlap on lower timeframes. 0 = off.")
var int lastSigBar = na
okGap = na(lastSigBar) or (bar_index - lastSigBar) >= minGap
buy  := buy  and okGap
sell := sell and okGap
sig  := buy or sell
if sig
    lastSigBar := bar_index

// ─────────────────────────────────────────────────────────────────────────
//  CONVICTION 0..100
// ─────────────────────────────────────────────────────────────────────────
proximity = na(nearDist) ? 0.0 : math.max(0.0, 1.0 - nearDist / (atrSafe * 3.0))
trendComp = (useTrend and (upTrend or dnTrend)) ? 1.0 : 0.5
countComp = math.min(1.0, (demandN + supplyN) / 6.0)
strComp   = sig ? sigStr : 0.0
convBase  = 0.40 * proximity + 0.25 * trendComp + 0.15 * countComp + 0.20 * strComp
conv      = math.round(100 * math.min(1.0, convBase + (sig ? 0.15 : 0.0)))

// ─────────────────────────────────────────────────────────────────────────
//  LIVE WIN-RATE  (TP1 before SL, no lookahead)
// ─────────────────────────────────────────────────────────────────────────
var int   wins   = 0
var int   losses = 0
var bool  sOpen  = false
var int   sDir   = 0
var float sSL    = na
var float sT1    = na

if sOpen
    if sDir == 1
        if high >= sT1
            wins   += 1
            sOpen  := false
        else if low <= sSL
            losses += 1
            sOpen  := false
    else
        if low <= sT1
            wins   += 1
            sOpen  := false
        else if high >= sSL
            losses += 1
            sOpen  := false

// ─────────────────────────────────────────────────────────────────────────
//  TP / SL BOXES  (red risk entry→SL, green reward entry→TP3)
// ─────────────────────────────────────────────────────────────────────────
var box   riskBox = na
var box   rewBox  = na
var line  lnE = na   // solid ENTRY line
var line  lnS = na   // dashed SL line
var line  ln1 = na   // TP1 inner divider
var line  ln2 = na   // TP2 inner divider
var label lbE = na
var label lbS = na
var label lb1 = na
var label lb2 = na
var label lb3 = na

var float tEntry = na
var float tSL    = na
var float tT1    = na
var float tT2    = na
var float tT3    = na

f_setLbl(label lb, float p, string txt, color c) =>
    label.set_xy(lb, bar_index + tradeExt, p)
    label.set_text(lb, txt)
    label.set_textcolor(lb, c)

if sig
    // close any open tracked trade before starting a new one
    if sOpen
        losses += 1
        sOpen  := false
    tEntry := close
    if buy
        tSL := sigBot - slBuf * atr
    else
        tSL := sigTop + slBuf * atr
    risk = math.abs(tEntry - tSL)
    tT1 := buy ? tEntry + risk * tp1R : tEntry - risk * tp1R
    tT2 := buy ? tEntry + risk * tp2R : tEntry - risk * tp2R
    tT3 := buy ? tEntry + risk * tp3R : tEntry - risk * tp3R

    // arm win-rate tracker
    sDir  := buy ? 1 : -1
    sSL   := tSL
    sT1   := tT1
    sOpen := true

    if showBox
        box.delete(riskBox)
        box.delete(rewBox)
        riskBox := box.new(bar_index, tEntry, bar_index + tradeExt, tSL, border_color = MAG, bgcolor = color.new(MAG, 82), border_width = 1)
        rewBox  := box.new(bar_index, tEntry, bar_index + tradeExt, tT3, border_color = LIME, bgcolor = color.new(LIME, 86), border_width = 1)
        // inner divider + entry/SL lines (created once, then repositioned via setters)
        if na(lnE)
            lnE := line.new(bar_index, tEntry, bar_index + tradeExt, tEntry, color = CYAN_HI, width = 2)
            lnS := line.new(bar_index, tSL,    bar_index + tradeExt, tSL,    color = MAG_HI, width = 1, style = line.style_dashed)
            ln1 := line.new(bar_index, tT1,    bar_index + tradeExt, tT1,    color = color.new(LIME, 25), width = 1, style = line.style_dotted)
            ln2 := line.new(bar_index, tT2,    bar_index + tradeExt, tT2,    color = color.new(LIME, 25), width = 1, style = line.style_dotted)
        f_setLine(lnE, bar_index, bar_index + tradeExt, tEntry)
        f_setLine(lnS, bar_index, bar_index + tradeExt, tSL)
        f_setLine(ln1, bar_index, bar_index + tradeExt, tT1)
        f_setLine(ln2, bar_index, bar_index + tradeExt, tT2)
        if na(lbE)
            lbE := label.new(bar_index + tradeExt, tEntry, "", style = label.style_label_left, color = color.new(BG, 100), size = size.small)
            lbS := label.new(bar_index + tradeExt, tSL, "", style = label.style_label_left, color = color.new(BG, 100), size = size.small)
            lb1 := label.new(bar_index + tradeExt, tT1, "", style = label.style_label_left, color = color.new(BG, 100), size = size.small)
            lb2 := label.new(bar_index + tradeExt, tT2, "", style = label.style_label_left, color = color.new(BG, 100), size = size.small)
            lb3 := label.new(bar_index + tradeExt, tT3, "", style = label.style_label_left, color = color.new(BG, 100), size = size.small)
        f_setLbl(lbE, tEntry, " ENTRY " + f_price(tEntry), CYAN_HI)
        f_setLbl(lbS, tSL, " SL " + f_price(tSL), MAG_HI)
        f_setLbl(lb1, tT1, " TP1 · " + str.tostring(tp1R, "#.#") + "R  " + f_price(tT1), LIME)
        f_setLbl(lb2, tT2, " TP2 · " + str.tostring(tp2R, "#.#") + "R  " + f_price(tT2), color.new(LIME, 10))
        f_setLbl(lb3, tT3, " TP3 · " + str.tostring(tp3R, "#.#") + "R  " + f_price(tT3), color.new(LIME, 20))

// keep the active trade graphic pinned to the right edge
if showBox and not na(riskBox) and barstate.islast
    box.set_right(riskBox, bar_index + tradeExt)
    box.set_right(rewBox, bar_index + tradeExt)
    line.set_x2(lnE, bar_index + tradeExt)
    line.set_x2(lnS, bar_index + tradeExt)
    line.set_x2(ln1, bar_index + tradeExt)
    line.set_x2(ln2, bar_index + tradeExt)
    label.set_x(lbE, bar_index + tradeExt)
    label.set_x(lbS, bar_index + tradeExt)
    label.set_x(lb1, bar_index + tradeExt)
    label.set_x(lb2, bar_index + tradeExt)
    label.set_x(lb3, bar_index + tradeExt)

resolved = wins + losses
winRate  = resolved > 0 ? wins / resolved * 100.0 : na

// ─────────────────────────────────────────────────────────────────────────
//  GLOBAL PLOTS
// ─────────────────────────────────────────────────────────────────────────
plot(showEMA ? ema : na, "Trend EMA", color = color.new(PURPLE, 20), linewidth = 2)
plotshape(buy,  "BUY",  style = shape.labelup,   location = location.belowbar, color = CYAN, textcolor = BG, text = "BUY",  size = size.small)
plotshape(sell, "SELL", style = shape.labeldown, location = location.abovebar, color = MAG, textcolor = BG, text = "SELL", size = size.small)
bgcolor(useTrend and upTrend ? color.new(CYAN, 95) : useTrend and dnTrend ? color.new(MAG, 95) : na, title = "Trend tint")
barcolor(colorBars ? (upTrend ? CYAN : dnTrend ? MAG : na) : na, title = "Trend candles")

// ─────────────────────────────────────────────────────────────────────────
//  CYBERPUNK DASHBOARD
// ─────────────────────────────────────────────────────────────────────────
// dashboard is fully adjustable — reposition (hudPos) and resize text (hudSize)
hudSize = input.string("Normal", "Dashboard text size", options = ["Tiny", "Small", "Normal", "Large"], group = "Dashboard")
hudTS = hudSize == "Tiny" ? size.tiny : hudSize == "Small" ? size.small : hudSize == "Large" ? size.large : size.normal
var table hud = na
if showHUD and barstate.islast
    if not na(hud)
        table.delete(hud)
    hud := table.new(f_pos(hudPos), 2, 8, bgcolor = color.new(hudBg, 0), frame_color = color.new(FRAME, 0), frame_width = 1, border_width = 0)
    SURF  = color.new(hudBg, 0)
    HEADR = color.new(color.from_gradient(0.5, 0, 1, hudBg, PURPLE), 55)

    trendT = upTrend ? "UPTREND" : dnTrend ? "DOWNTREND" : "FLAT"
    trendC = upTrend ? CYAN_HI : dnTrend ? MAG_HI : MUTE
    nearT  = na(nearDist) ? "—" : f_price(nearDist)
    // orderflow-depth: which side dominates the nearby book
    tilt   = demandN > supplyN ? "▲ DEMAND-HEAVY" : supplyN > demandN ? "▼ SUPPLY-HEAVY" : "• BALANCED"
    tiltC  = demandN > supplyN ? CYAN_HI : supplyN > demandN ? MAG_HI : MUTE
    sigT   = buy ? "BUY ▲" : sell ? "SELL ▼" : "Waiting"
    sigC   = buy ? CYAN_HI : sell ? MAG_HI : MUTE

    cF = math.round(conv / 100.0 * 10)
    cbar = ""
    for i = 1 to 10
        cbar := cbar + (i <= cF ? "▰" : "▱")
    convC = conv >= 66 ? CYAN_HI : conv >= 33 ? AMBER : MUTE
    statTxt = na(winRate) ? "—" : str.tostring(math.round(winRate)) + "% (" + str.tostring(resolved) + ")"
    statC   = na(winRate) ? MUTE : winRate >= 55 ? LIME : winRate <= 45 ? MAG_HI : AMBER

    // TITLE bar + big NEAREST-OB headline
    table.cell(hud, 0, 0, "  ▓ ORDERFLOW DEPTH", text_color = INKHI, text_halign = text.align_left, bgcolor = HEADR, text_size = hudTS)
    table.cell(hud, 1, 0, "JOAT  ", text_color = PURPLE, text_halign = text.align_right, bgcolor = HEADR, text_size = hudTS)
    table.cell(hud, 0, 1, "  NEAREST OB", text_color = MUTE, text_halign = text.align_left, bgcolor = SURF, text_size = hudTS)
    table.cell(hud, 1, 1, nearT + "  ", text_color = AMBER, text_halign = text.align_right, bgcolor = SURF, text_size = hudTS)
    // depth bars — Demand (cyan) vs Supply (magenta)
    table.cell(hud, 0, 2, "  Demand " + str.tostring(demandN), text_color = CYAN_HI, text_halign = text.align_left, bgcolor = SURF, text_size = hudTS)
    table.cell(hud, 1, 2, f_depth(demandN) + "  ", text_color = CYAN_HI, text_halign = text.align_right, bgcolor = SURF, text_size = hudTS)
    table.cell(hud, 0, 3, "  Supply " + str.tostring(supplyN), text_color = MAG_HI, text_halign = text.align_left, bgcolor = SURF, text_size = hudTS)
    table.cell(hud, 1, 3, f_depth(supplyN) + "  ", text_color = MAG_HI, text_halign = text.align_right, bgcolor = SURF, text_size = hudTS)
    table.cell(hud, 0, 4, "  Book tilt", text_color = MUTE, text_halign = text.align_left, bgcolor = SURF, text_size = hudTS)
    table.cell(hud, 1, 4, tilt + "  ", text_color = tiltC, text_halign = text.align_right, bgcolor = SURF, text_size = hudTS)
    table.cell(hud, 0, 5, "  Conviction", text_color = MUTE, text_halign = text.align_left, bgcolor = SURF, text_size = hudTS)
    table.cell(hud, 1, 5, cbar + " " + str.tostring(conv) + "  ", text_color = convC, text_halign = text.align_right, bgcolor = SURF, text_size = hudTS)
    table.cell(hud, 0, 6, "  Signal", text_color = MUTE, text_halign = text.align_left, bgcolor = SURF, text_size = hudTS)
    table.cell(hud, 1, 6, sigT + "  ", text_color = sigC, text_halign = text.align_right, bgcolor = SURF, text_size = hudTS)
    table.cell(hud, 0, 7, "  Win (TP1)", text_color = MUTE, text_halign = text.align_left, bgcolor = HEADR, text_size = hudTS)
    table.cell(hud, 1, 7, statTxt + "  ", text_color = statC, text_halign = text.align_right, bgcolor = HEADR, text_size = hudTS)

// ─────────────────────────────────────────────────────────────────────────
//  ALERTS
// ─────────────────────────────────────────────────────────────────────────
alertcondition(buy,  "Buy",  "S&D Order Blocks: bullish rejection off a fresh demand block")
alertcondition(sell, "Sell", "S&D Order Blocks: bearish rejection off a fresh supply block")
alertcondition(newBullDisp, "New Demand Block", "S&D Order Blocks: a new demand (bullish) order block formed")
alertcondition(newBearDisp, "New Supply Block", "S&D Order Blocks: a new supply (bearish) order block formed")
